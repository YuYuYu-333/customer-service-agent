# 复制本文件为 .env，把下面两行的值换成你自己的密钥

# DeepSeek 开放平台：https://platform.deepseek.com
DEEPSEEK_API_KEY=

# 硅基流动：https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=

# Redis 会话存储。不填则退回进程内存：单 worker 可用，多 worker 会话会串。
# 本地：redis://127.0.0.1:6379/0
# 有密码：redis://:密码@主机:6379/0
REDIS_URL=

# 限流与配额。留空用默认值：每分钟 10 次 / 每天 100 万 prompt token
RATE_LIMIT_PER_MINUTE=
DAILY_TOKEN_LIMIT=
